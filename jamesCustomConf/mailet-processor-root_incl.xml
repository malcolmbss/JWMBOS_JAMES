<processor state="root" enableJmx="true">

   <mailet match="All" class="PostmasterAlias" />

   <mailet match="All" class="RootLogger" />

   <mailet match="All" class="JWMHSetMimeHeader">
      <name>X-Processor-Root</name>
      <value>true</value>
   </mailet>

   <mailet match="RelayLimit=30" class="ToRepository">
      <repositoryPath>postgres://var/mail/relay-limit-exceeded/</repositoryPath>
   </mailet>

   <mailet match="SMTPAuthSuccessful" class="ToProcessor">
      <processor>authorized-outbound</processor>
   </mailet>

   <mailet match="All" class="ToProcessor">
      <processor>inbound</processor>
   </mailet>

</processor>
