<processor state="spam" enableJmx="true">
   <mailet match="All" class="JWMHSetMimeHeader">
      <name>X-Processor-Spam-Final-Assessment</name>
      <value>true</value>
   </mailet>

   <!-- the purpose of this processor is to normalize to a single header for binary spam/not-spam decision
        used by JWMBOS Sieve configuration to determine target folder.
        Flag is set now... back to transport for final folder processing -->

   <mailet match="All" class="ToProcessor">
      <processor>transport</processor>
   </mailet>
</processor>
