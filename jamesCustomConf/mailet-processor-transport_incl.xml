<processor state="transport" enableJmx="true">
   <!-- matcher 'macro' to be used later in processor -->
   <matcher name="relay-allowed" match="org.apache.james.mailetcontainer.impl.matchers.Or">
      <matcher match="SMTPAuthSuccessful" />
      <matcher match="SMTPIsAuthNetwork" />
      <matcher match="SentByMailet" />
      <matcher match="org.apache.james.jmap.mailet.SentByJmap" />
   </matcher>

   <mailet match="All" class="RemoveMimeHeader">
      <name>bcc</name>
      <onMailetException>ignore</onMailetException>
   </mailet>

   <mailet match="All" class="RemoveMimeHeader">
      <name>X-SMIME-Status</name>
      <onMailetException>ignore</onMailetException>
   </mailet>

   <mailet match="All" class="JWMHSetMimeHeader">
      <name>X-Processor-Transport</name>
      <value>true</value>
   </mailet>

   <mailet match="SMTPAuthSuccessful" class="JWMHSetMimeHeader">
      <name>X-UserIsAuth</name>
      <value>true</value>
   </mailet>

   <mailet match="HasMailAttribute=org.apache.james.SMIMECheckSignature" class="JWMHSetMimeHeader">
      <name>X-WasSigned</name>
      <value>true</value>
   </mailet>

   <mailet match="All" class="RecipientRewriteTable">
      <errorProcessor>rrt-error</errorProcessor>
   </mailet>

   <mailet match="RecipientIsLocal" class="VacationMailet">
      <onMailetException>ignore</onMailetException>
   </mailet>

   <mailet match="RecipientIsLocal" class="org.apache.james.jmap.mailet.filter.JMAPFiltering">
      <onMailetException>ignore</onMailetException>
   </mailet>


   <mailet match="RecipientIsLocal" class="Sieve" />

 <!-- Route globally classified spam into the Spam folder -->
   <mailet match="FileRegexMatcher=/opt/james/conf/spam-header.regex" class="WithStorageDirective">
       <targetFolderName>Spam</targetFolderName>
   </mailet>

   <mailet match="RecipientIsLocal" class="AddDeliveredToHeader" />

   <mailet match="RecipientIsLocal" class="LocalDelivery" />

   <!-- If the host is handled by this server and it did not get -->
   <!-- locally delivered, this is an invalid recipient -->
   <mailet match="HostIsLocal" class="ToProcessor">
      <processor>local-address-error</processor>
      <notice>550 - Requested action not taken: no such user here</notice>
   </mailet>

   <!-- not local host or recipient... determine if outbound -->
   <mailet match="relay-allowed" class="ToProcessor">
      <processor>relay</processor>
   </mailet>
</processor>

<processor state="relay" enableJmx="true">
   <!-- begin processing for outbound -->
   <!-- Add a server-side signature -->
   <!--
       <mailet match="All" class="SMIMESign" onMailetException="ignore">
          <keyStoreType>jks</keyStoreType>
          <keyStoreFileName>path.keystore</keyStoreFileName>
          <keyStorePassword>myKeyStorePass</keyStorePassword>
          <keyAlias>myKeyAlias</keyAlias>
          <keyAliasPassword>myKeyPass</keyAliasPassword>
          <signerName>XXX Trusted Server</signerName>
          <rebuildFrom>true</rebuildFrom>
          <postmasterSigns>true</postmasterSigns>
          <debug>true</debug>
       </mailet>
     -->

     <!-- Convert MIME content before DKIM signing -->
          <mailet match="All" class="org.apache.james.jdkim.mailets.ConvertTo7Bit" />

     <!-- Sign outbound messages using the From domain and shared RSA key -->
          <mailet match="All"
                  class="org.apache.james.transport.mailets.JWMDKIMSign">
                  <selector>primary</selector>
                  <privateKeyFilepath>/opt/james/conf/dkim/primary-pkcs8.key</privateKeyFilepath>
                  <forceCRLF>true</forceCRLF>
          </mailet>

   <mailet match="SenderIs=techstuff@malcolms.com" class="ToProcessor">
      <processor>RemoteDeliveryNoGateway</processor>
   </mailet>

   <mailet match="All" class="ExtLogger">
      <event>EXT_LOG_REMOTEDELIVERY</event>
   </mailet>

   <mailet match="All" class="RemoteDelivery">
      <outgoingQueue>outgoing</outgoingQueue>
      <delayTime>5000, 100000, 500000, 48*1 hour</delayTime>
      <maxRetries>51</maxRetries>
      <maxDnsProblemRetries>0</maxDnsProblemRetries>
      <deliveryThreads>10</deliveryThreads>
      <sendpartial>true</sendpartial>
      <bounceProcessor>bounces</bounceProcessor>

      <!-- recommended in a blog to fix dkim problems -->
      <mail.smtp.allow8bitmime>false</mail.smtp.allow8bitmime>

      <!-- gmail and others have higher trust for mail coming through gateway, but AWS SES must pre-approve the domains that can utilize the gateway -->
      <!-- also currently ALL apache.org forums REJECT SES (gateway) emails because SES changes the Return-Path header which apache uses to identify subscriber -->
      <gateway>email-smtp.us-east-1.amazonaws.com</gateway>
      <gatewayPort>587</gatewayPort>
      <gatewayUsername>${env:JAMES_SES_SMTP_USERNAME}</gatewayUsername>
      <gatewayPassword>${env:JAMES_SES_SMTP_PASSWORD}</gatewayPassword>

      <!-- Set the HELO/EHLO name to use when connectiong to remote SMTP-Server -->
      <!-- JWM note - this must be here... and it must be elastic IP.  Otherwise it picks up AWS internal ip and recipients score it as spam -->
      <mail.smtp.localhost>mail-jwmbos.jwmhosting.com</mail.smtp.localhost>
      <!-- elastic ip domain name -->

      <!-- if ip addresses are specified here, must use the AWS PRIVATE internal ip address; not the external elastic IP address -->
      <mail.smtp.localaddress>172.26.9.131</mail.smtp.localaddress>
      <!-- AWS EC2 PRIVATE ip address -->
   </mailet>
</processor>
